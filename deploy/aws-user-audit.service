[Unit]
Description=AWS daily multi-account operation audit and PDF email
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/root
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/usr/local/aws-user-audit
ExecStart="/usr/local/aws-user-audit/.venv/bin/python" "/usr/local/aws-user-audit/deploy/run_scheduled.py" "--install-dir" "/usr/local/aws-user-audit" "--config" "/usr/local/aws-user-audit/aws-audit-config.json"
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
