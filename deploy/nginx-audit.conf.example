# 当前部署不使用网页密码，只替换两个审计路由，其他业务 location 保留。
location = /audit {
    absolute_redirect off;
    return 302 /audit/;
}

location ^~ /audit/ {
    absolute_redirect off;
    alias /usr/local/shenji/index/;
    index index.html;
    autoindex off;
    expires -1;
    default_type application/octet-stream;
    types {
        text/html html;
        text/css css;
        application/javascript js;
    }
}
