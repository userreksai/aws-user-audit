# 放进现有提供 /audit/ 的 server {}，替换旧 /audit/ 静态 location。
# 不要新建第二个同名 location，也不要保留绕过认证的 alias/root 路由。
# 如果 9999 前面还有 HTTPS 代理，每一层都必须保留原始 Host。
location = /audit {
    return 302 /audit/;
}

location ^~ /audit/ {
    proxy_pass http://127.0.0.1:9998;
    proxy_http_version 1.0;
    proxy_redirect off;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header Connection "";
    proxy_set_header Authorization "";
    proxy_connect_timeout 3s;
    proxy_send_timeout 15s;
    proxy_read_timeout 15s;
    client_max_body_size 2k;
    client_body_timeout 10s;
    proxy_request_buffering on;
    proxy_buffering off;
    proxy_cache off;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    proxy_intercept_errors off;
    # 不继承 server 层可能把上游错误回退到公开静态HTML的 error_page。
    error_page 500 502 503 504 =503 @audit_password_unavailable;
}

location @audit_password_unavailable {
    default_type text/plain;
    return 503 "Audit authentication unavailable.\n";
}
